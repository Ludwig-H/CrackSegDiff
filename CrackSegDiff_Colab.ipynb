   "source": [
    "# CrackSegDiff Training and Testing on Colab\n",
    "\n",
    "This notebook sets up the environment, downloads data and weights, trains the CrackSegDiff model, and runs inference on the first 500 images for Intensity, Range, and Fused modalities."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Check GPU\n",
    "!nvidia-smi"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Clone Repository\n",
    "!git clone https://github.com/sky-visionX/CrackSegDiff.git\n",
    "%cd CrackSegDiff"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Install Dependencies\n",
    "# Install core requirements\n",
    "!pip install -r requirement.txt\n",
    "\n",
    "# Install Mamba-related dependencies (order matters and requires CUDA)\n",
    "!pip install causal_conv1d==1.0.0\n",
    "!pip install mamba_ssm==1.0.1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. Prepare Pretrained Weights\n",
    "# Download VMamba weights from Google Drive\n",
    "!mkdir -p pretrained_weights\n",
    "!gdown 1JYqMxM5dbCLZ-WGPKtIofYJhj0VPuy3l -O pretrained_weights/vssm_base_0229_ckpt_epoch_237.pth"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Patch Code (Fix hardcoded paths)\n",
    "# The original code has a hardcoded absolute path in CrackSegDiff/guided_diffusion/unet.py\n",
    "# We replace it with the correct Colab path.\n",
    "\n",
    "import os\n",
    "\n",
    "target_file = 'CrackSegDiff/guided_diffusion/unet.py'\n",
    "old_path = '/home/dell/jlc/segdiff/pre_trained_weights/vssm_base_0229_ckpt_epoch_237.pth'\n",
    "new_path = os.path.abspath('pretrained_weights/vssm_base_0229_ckpt_epoch_237.pth')\n",
    "\n",
    "print(f\"Patching {target_file}...\")\n",
    "print(f\"Replacing '{old_path}' with '{new_path}'\")\n",
    "\n",
    "with open(target_file, 'r') as f:\n",
    "    content = f.read()\n",
    "\n",
    "if old_path in content:\n",
    "    content = content.replace(old_path, new_path)\n",
    "    with open(target_file, 'w') as f:\n",
    "        f.write(content)\n",
    "    print(\"Success!\")\n",
    "else:\n",
    "    print(\"Warning: Old path not found. Please check if the code has changed or if patching is already done.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. Prepare Dataset (FIND Dataset)\n",
    "# You need to download the FIND dataset. \n",
    "# Since direct download links (wget) for Zenodo might expire or require confirmation,\n",
    "# we assume you can use zenodo_get or gdown if you have a link. \n",
    "# Here we use 'zenodo_get' tool to download it easily.\n",
    "\n",
    "!pip install zenodo_get\n",
    "!mkdir -p data\n",
    "%cd data\n",
    "!zenodo_get 6383044\n",
    "# Unzip files (adjust filename if different)\n",
    "!unzip -q *.zip\n",
    "\n",
    "# The code expects specific directory structure. \n",
    "# Let's assume the zip extracts to 'FIND-Dataset' or similar. We need to normalize it.\n",
    "# We will inspect the directory and move files if necessary to match: \n",
    "# data_dir/5d (images)\n",
    "# data_dir/mask (masks)\n",
    "\n",
    "import os\n",
    "import shutil\n",
    "\n",
    "# Helper to organize data if needed. \n",
    "# Adjust 'source_dir' based on what 'unzip' produces.\n",
    "# Assuming standard FIND structure, but flattening it for the loader if needed.\n",
    "\n",
    "# NOTE: You might need to manually adjust this block depending on the exact zip content structure.\n",
    "%cd .."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7. Train the Model\n",
    "# Adjust parameters as needed. Using defaults from README but smaller batch size if needed.\n",
    "\n",
    "!python CrackSegDiff/segmentation_train.py \
",
    "  --data_dir ./data/FIND-Dataset/train \
",
    "  --out_dir ./results/train_output \
",
    "  --image_size 256 \
",
    "  --num_channels 128 \
",
    "  --class_cond False \
",
    "  --num_res_blocks 2 \
",
    "  --num_heads 1 \
",
    "  --learn_sigma True \
",
    "  --use_scale_shift_norm False \
",
    "  --attention_resolutions 16 \
",
    "  --diffusion_steps 1000 \
",
    "  --noise_schedule linear \
",
    "  --rescale_learned_sigmas False \
",
    "  --rescale_timesteps False \
",
    "  --lr 5e-5 \
",
    "  --batch_size 8 \
",
    "  --save_interval 10000 # Save more frequently to ensure we have a checkpoint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 8. Test / Inference\n",
    "# We run inference on 3 modalities: Intensity, Range, Fused.\n",
    "# We use the latest checkpoint saved in ./results/train_output\n",
    "\n",
    "import glob\n",
    "import os\n",
    "\n",
    "# Find latest model\n",
    "model_files = sorted(glob.glob('./results/train_output/*.pt'))\n",
    "if model_files:\n",
    "    latest_model = model_files[-1]\n",
    "    print(f\"Using model: {latest_model}\")\n",
    "else:\n",
    "    print(\"No model found! Using default or please specify.\")\n",
    "    latest_model = \"./pretrained_weights/savedmodel100000.pt\" # Fallback if you have one\n",
    "\n",
    "modalities = ['intensity', 'range', 'fused']\n",
    "\n",
    "for mod in modalities:\n",
    "    print(f\"--- Testing Modality: {mod} ---\")\n",
    "    out_path = f\"./results/test_output_{mod}\"
",
    "    !mkdir -p {out_path}\n",
    "    \n",
    "    !python CrackSegDiff/segmentation_sample.py \
",
    "      --data_dir ./data/FIND-Dataset/test \
",
    "      --out_dir {out_path} \
",
    "      --model_path {latest_model} \
",
    "      --modality {mod} \
",
    "      --image_size 256 \
",
    "      --num_channels 128 \
",
    "      --class_cond False \
",
    "      --num_res_blocks 2 \
",
    "      --num_heads 1 \
",
    "      --learn_sigma True \
",
    "      --use_scale_shift_norm False \
",
    "      --attention_resolutions 16 \
",
    "      --diffusion_steps 1000 \
",
    "      --noise_schedule linear \
",
    "      --rescale_learned_sigmas False \
",
    "      --rescale_timesteps False \
",
    "      --num_ensemble 1\n",
    "\n",
    "    print(f\"Finished {mod}. Results in {out_path}\")"
   ]
  },
